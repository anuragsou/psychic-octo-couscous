# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Zepto target
ZEPTO_PRODUCT_URL=https://www.zeptonow.com/pn/example/pvid/replace-product-variant-id
ZEPTO_PINCODE=560001
# Optional: helps Zepto's location picker when pincode alone is ambiguous.
ZEPTO_LOCATION_TEXT=New Maninagar 560001

# Tracker behavior
CHECK_INTERVAL_SECONDS=300
NOTIFY_ON_EVERY_CHECK=false
LOW_STOCK_THRESHOLD=3
ENABLE_CART_QUANTITY_PROBE=true
MAX_QUANTITY_PROBE=30
RUN_ONCE=false

# Browser behavior
# Keep false for the first setup run if Zepto asks you to confirm location manually.
HEADLESS=true
BROWSER_PROFILE_DIR=.browser-profile
NAVIGATION_TIMEOUT_MS=60000

# Telegram command polling
ENABLE_TELEGRAM_COMMANDS=true

# Debug files are written to .debug/ when enabled.
DEBUG=false
